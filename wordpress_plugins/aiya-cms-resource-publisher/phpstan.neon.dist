includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
    level: 8

    # Analysis target: the runtime PHP (plugin header "Requires PHP: 8.5").
    # The composer constraint also admits 8.4, and PHPCompatibility checks
    # that lower bound — see testVersion in phpcs.xml.dist.
    phpVersion: 80500

    paths:
        - aiya-publish.php
        - src

    excludePaths:
        analyse:
            - */vendor/*

    bootstrapFiles:
        - vendor/szepeviktor/phpstan-wordpress/bootstrap.php

    # src/Model/PicBedBridge.php borrows aiya-core's pic-bed classes at
    # runtime, and the QA container deploys this plugin next to core
    # (wp-content/plugins/aiya-core). Symbol-scanning core's sources
    # resolves those references; core's own files are not analysed
    # here, scanDirectories only registers their symbols.
    scanDirectories:
        - ../aiya-core/src

    inferPrivatePropertyTypeFromConstructor: true
    treatPhpDocTypesAsCertain: false
